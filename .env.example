# Smartsheet Resource Management (10,000ft) API Token
export SMARTSHEET_RM_API_TOKEN='your_smartsheet_rm_api_token_here'

# Optional API Base URL (defaults to https://api.rm.smartsheet.com/api/v1)
export SMARTSHEET_RM_BASE_URL='https://api.rm.smartsheet.com/api/v1'

# Optional Smartsheet Gov (opt-in): set all three, per
# https://developers.smartsheet.com/api/resource_management/getting-started/authentication
# export SMARTSHEET_RM_BASE_URL='https://app.smartsheetgov.com/2.0/rm/api/v1'
# export SMARTSHEET_RM_ALLOWED_HOSTS='app.smartsheetgov.com'
# export SMARTSHEET_RM_GOV_SMARTSHEET_API_TOKEN='your_smartsheet_api_token_here'

# Optional Profile Filtering: 'time', 'projects', 'admin', or 'full' (default)
# export SMARTSHEET_RM_PROFILE='full'

# Optional Safety Flags
# export SMARTSHEET_RM_READONLY=1
# export SMARTSHEET_RM_ALLOW_BULK_DESTRUCTIVE=1

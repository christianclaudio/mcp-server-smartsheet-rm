# Smartsheet Resource Management (10,000ft) API Token
export SMARTSHEET_RM_API_TOKEN='your_smartsheet_rm_api_token_here'

# Optional API Base URL (defaults to https://api.rm.smartsheet.com/api/v1)
export SMARTSHEET_RM_BASE_URL='https://api.rm.smartsheet.com/api/v1'

